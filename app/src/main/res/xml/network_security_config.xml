<?xml version="1.0" encoding="utf-8"?>
<!-- Theme install from a GitHub link is the only network use (THEME_ARCHITECTURE.md §4.1): HTTPS only, system trust anchors only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
